# Development environment: cp .env.dev.example .env && docker compose up -d
# Public example values: never use them on a server (see .env.prod.example).
COMPOSE_PROFILES=mailpit

SALEOR_URL=http://localhost:8113
SITE_ADDRESS=:80
HTTP_PORT=8113
HTTPS_PORT=8413
MAILPIT_PORT=8025

SECRET_KEY=dev-secret-key
DB_PASSWORD=saleor
SALEOR_ADMIN_EMAIL=admin@example.com
SALEOR_ADMIN_PASSWORD=admin12345

# GraphQL playground on GET /graphql/.
SALEOR_PLAYGROUND=True
# Allow webhooks and apps on the host (http://host.docker.internal:<port>).
HTTP_IP_FILTER_ENABLED=False

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com
SMTP_FROM_NAME=Tienda
SALEOR_STORE_NAME=Tienda
