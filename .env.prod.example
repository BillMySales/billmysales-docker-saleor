# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only), tools
# (console).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=saleor

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the site: dashboard (<url>/dashboard/), GraphQL API
# (<url>/graphql/), media. Applied on every `up`.
SALEOR_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
# Other host names the API answers on (comma separated; SALEOR_URL's host is
# always allowed).
#SALEOR_ALLOWED_HOSTS=
# Hosts of storefronts or apps that may receive redirect links (password
# reset, account confirmation), comma separated; SALEOR_URL's host is
# always allowed. E.g. www.example.com
#SALEOR_ALLOWED_CLIENT_HOSTS=
# Origins allowed to call the API from a browser (CORS), comma separated.
#ALLOWED_GRAPHQL_ORIGINS=*
# GraphQL playground on GET /graphql/.
#SALEOR_PLAYGROUND=False

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -hex 32)
# ---------------------------------------------------------------------------
SECRET_KEY=
DB_PASSWORD=
# First admin (superuser, created on the first run; its password is set only
# then).
SALEOR_ADMIN_EMAIL=
SALEOR_ADMIN_PASSWORD=
#DB_USER=saleor
#DB_NAME=saleor

# ---------------------------------------------------------------------------
# Store (initial settings, applied only on the first install; later changes
# in the dashboard are kept)
# ---------------------------------------------------------------------------
#SALEOR_STORE_NAME=Saleor
#SALEOR_CHANNEL_NAME=Tienda
#SALEOR_CHANNEL_SLUG=default-channel
#SALEOR_CURRENCY=CLP
#SALEOR_COUNTRY=CL
#SALEOR_CITY=Santiago
# Shipping zone of the country (with a free "Despacho" method).
#SALEOR_ZONE_NAME=Chile
# Flat tax rate of the country (%); empty = none.
#SALEOR_TAX_RATE=19
# Prices include tax (as usual in Chile).
#SALEOR_PRICES_INCLUDE_TAX=true
# Orders can be placed without a payment app (staff marks them as paid,
# like a bank transfer).
#SALEOR_ALLOW_UNPAID_ORDERS=true
# Spanish email templates and subjects.
#SALEOR_EMAILS_SPANISH=true
# Locale of amounts in emails ($19.980).
#SALEOR_EMAIL_LOCALE=es_CL

# ---------------------------------------------------------------------------
# Webhooks and apps
# ---------------------------------------------------------------------------
# Refuse webhook and app URLs on private or loopback addresses (SSRF
# protection). Set to False only for apps on a private network.
#HTTP_IP_FILTER_ENABLED=True
#HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=False
# Usage data sent to usage-telemetry.saleor.io.
#SEND_USAGE_TELEMETRY=False

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Saleor API image (ghcr.io/saleor/saleor) and dashboard. After changing
# them, `docker compose up -d` pulls the images and `setup` migrates. Back up
# first.
#SALEOR_VERSION=3.23.36
#SALEOR_DASHBOARD_VERSION=3.23.34
#POSTGRES_VERSION=15
#VALKEY_VERSION=8.1
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# Mail (SMTP): order emails to customers and staff, password resets, staff
# invitations. No emails without SMTP_HOST (the email plugins stay off).
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS, usually port 587), ssl (SMTPS, port 465) or none.
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address and name (the name defaults to the store's).
#SMTP_FROM=noreply@example.com
#SMTP_FROM_NAME=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Processes, resources and logs
# ---------------------------------------------------------------------------
# uvicorn workers of the API and Celery worker processes.
#UVICORN_WORKERS=2
#CELERY_CONCURRENCY=2
#UPLOAD_MAX_SIZE=32M
#DB_MEMORY_LIMIT=1g
#VALKEY_MEMORY_LIMIT=256m
#SETUP_MEMORY_LIMIT=1g
#API_MEMORY_LIMIT=1g
#WORKER_MEMORY_LIMIT=1g
#BEAT_MEMORY_LIMIT=512m
#DASHBOARD_MEMORY_LIMIT=128m
#CADDY_MEMORY_LIMIT=256m
#CONSOLE_MEMORY_LIMIT=1g
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
